{
  "name": "scent-roads",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "A cozy perfume-house game for phones.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "sounds": "node scripts/fetch-sounds.mjs",
    "factcheck": "node scripts/fact-check.mjs"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "three": "^0.186.1"
  }
}
